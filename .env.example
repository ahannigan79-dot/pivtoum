# Pivotum environment. Copy to .env.local for dev; set the same in Vercel
# (Project → Settings → Environment Variables), then redeploy — env changes only
# take effect on a new build.
#
# [REQUIRED] = the paid community (/hub) will not work without it.
# [optional] = has a safe default in code, or only enables a secondary feature.
#
# The public free tier (career index, /map exposure report) needs none of the
# [REQUIRED] community vars.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://pivotum.ai            # [optional] canonical URL for metadata/OG/redirects
NEXT_PUBLIC_JOIN_URL=/hub                            # [optional] where "join" CTAs point (defaults to /hub)

# ============================================================================
# COMMUNITY PLATFORM (/hub) — the member space.
# ============================================================================

# --- Clerk (auth + member accounts) --- [REQUIRED]
# Create an app at dashboard.clerk.com; copy both keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Route Clerk at our own sign-in/up pages and land members in the hub:
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/hub
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/hub

# --- Postgres --- [REQUIRED]
# Auto-injected when you attach a Vercel Postgres store. For local dev, paste it.
# DATABASE_URL is read as a fallback by drizzle-kit; POSTGRES_URL is what the app uses.
POSTGRES_URL=postgres://...
DATABASE_URL=postgres://...

# --- Stripe (membership subscription) ---
STRIPE_SECRET_KEY=sk_test_...          # [REQUIRED] enables all billing
STRIPE_MEMBERSHIP_PRICE_ID=price_...   # [REQUIRED] the recurring membership Price; without it the join button stays hidden
STRIPE_WEBHOOK_SECRET=whsec_...        # [REQUIRED] signing secret for the /api/webhook endpoint
STRIPE_MEMBERSHIP_TRIAL_DAYS=3         # [optional] card-required trial length; 0 or unset = no trial
STRIPE_FOUNDING_COUPON_ID=            # [optional] founding-member discount coupon id
STRIPE_LEAD_COUPON_ID=                # [optional] lead discount coupon id
# Webhook must subscribe to: checkout.session.completed,
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted

# --- Anthropic (Claude) --- [REQUIRED for AI features]
# Powers the Map reading, Workflow Rebuilds, Judgment Gym generation, article
# relevance and the newsletter draft. Unset = those features no-op gracefully.
ANTHROPIC_API_KEY=sk-ant-...

# --- Web push (VAPID) --- [REQUIRED for phone notifications]
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=          # same value as VAPID_PUBLIC_KEY (exposed to the browser)
VAPID_SUBJECT=mailto:hello@pivotum.ai  # [optional] defaults to this

# --- Cron --- [REQUIRED for scheduled jobs]
# Shared secret for the /api/cron/* routes (digest, reminders, pod rituals,
# article scout, lifecycle sweep). Vercel Cron sends it as a Bearer header.
# Any long random string. Without it, every cron returns 503.
CRON_SECRET=change-me-to-a-long-random-string

# --- Founder access --- [REQUIRED]
# Comma-separated emails that get founder powers (admin, moderation, /admin,
# schema migrate, gym/rebuild generation). Match the founder's Clerk email.
FOUNDER_EMAILS=you@example.com

# ============================================================================
# SUPPORTING / SECONDARY
# ============================================================================

# --- Resend (transactional + newsletter email) --- [optional but strongly recommended]
RESEND_API_KEY=re_...
EMAIL_FROM="Pivotum <hello@pivotum.ai>"

# --- Vercel Blob (uploaded files / legacy PDFs) --- [optional]
# Auto-injected when you attach a Blob store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Signing secret for time-limited download links + admin utility routes ---
DOWNLOAD_SIGNING_SECRET=change-me-to-a-long-random-string   # [optional]

# --- Booking links --- [optional]
EXPERT_BOOKING_URL=                    # 1:1 expert-session booking (Cal.com/Calendly etc.)
NEXT_PUBLIC_WELCOME_BOOKING_URL=       # member welcome-call booking link

# --- Substack (email capture mirror) --- [optional]
# Defaults to https://pivotum.substack.com; set only to point elsewhere.
SUBSTACK_PUBLICATION_URL=

# --- Analytics / advertising (all [optional]; live defaults baked into code) ---
NEXT_PUBLIC_META_PIXEL_ID=             # override the default Meta pixel id
META_CAPI_TOKEN=                       # Meta Conversions API (server-side events)
NEXT_PUBLIC_CLARITY_ID=                # override the default Microsoft Clarity project
NEXT_PUBLIC_GOOGLE_ADS_ID=             # override the default Google Ads id
NEXT_PUBLIC_GADS_LEAD_LABEL=           # Google Ads conversion label for signups
NEXT_PUBLIC_GADS_PURCHASE_LABEL=       # Google Ads conversion label for purchases
GADS_IMPORT_CONVERSION_NAME=           # name of the Ads offline-import conversion action
