# Pivotum environment. Copy to .env.local for dev; set the same in Vercel.
# The public free tier needs none of these — only the commerce tier (steps 7–9).

# Canonical site URL (used for metadata, sitemap, OG, and redirect URLs).
NEXT_PUBLIC_SITE_URL=https://pivotum.ai

# --- Stripe (checkout + webhook) ---
STRIPE_SECRET_KEY=sk_test_...
# From the Stripe CLI / dashboard webhook endpoint for checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Vercel Postgres (orders) ---
# Auto-injected when you attach a Postgres store in Vercel. For local dev, paste it:
POSTGRES_URL=postgres://...

# --- Vercel Blob (profile PDFs) ---
# Auto-injected when you attach a Blob store. Upload PDFs as profiles/<slug>.pdf
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Resend (transactional delivery email) ---
RESEND_API_KEY=re_...
EMAIL_FROM="Pivotum <profiles@pivotum.com>"

# --- Substack (email capture mirror) ---
# Defaults to https://pivotum.substack.com in app/api/subscribe/route.ts, so no
# env var is needed. Set this only to point signups at a different publication.
# Mirrored best-effort; Postgres stays the source of truth.
SUBSTACK_PUBLICATION_URL=

# --- Meta (Facebook) Pixel ---
# The live pixel/dataset ID is baked into lib/pixel.ts as the default, so no env
# var is needed. Set this only to OVERRIDE it (e.g. a separate test pixel); it is
# public and inlined at build time, so a redeploy is required to take effect.
# Fires PageView (all pages), Lead (email signup), Purchase (checkout success),
# and only after the visitor accepts the consent banner.
NEXT_PUBLIC_META_PIXEL_ID=

# --- Microsoft Clarity (session replay + heatmaps) ---
# Behavioural analytics. The live project id is baked into lib/clarity.ts as the
# default, so no env var is needed. Set this only to OVERRIDE it (e.g. a separate
# test project); it is public and inlined at build time, so a redeploy is required
# to take effect. It loads only after the visitor accepts (same gate as the pixel).
NEXT_PUBLIC_CLARITY_ID=

# --- Google Ads (gtag.js) ---
# The Ads ID is baked into lib/google.ts as the default (AW-18367563898); set
# this only to override. Conversion labels (the part after the slash in a
# send_to like "AW-18367563898/AbCd...") must be filled in for conversions to
# fire — get them from each conversion action's tag setup in Google Ads.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GADS_LEAD_LABEL=
NEXT_PUBLIC_GADS_PURCHASE_LABEL=

# --- Signing secret for time-limited download links (any long random string) ---
DOWNLOAD_SIGNING_SECRET=change-me-to-a-long-random-string

# ============================================================================
# COMMUNITY PLATFORM (/hub) — added for the member space that replaces Mighty.
# ============================================================================

# --- Clerk (auth + member accounts) ---
# Create an app at dashboard.clerk.com; copy both keys. Required to build /hub.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Route Clerk at our own sign-in/up pages and land members in the hub:
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/hub
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/hub

# --- Drizzle ---
# Reuses the existing POSTGRES_URL above. Run `npx drizzle-kit push` to create
# the community tables (profiles, posts, pods, events, …) in that database.
